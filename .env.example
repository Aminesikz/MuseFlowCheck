# Copy to .env and fill in. Never commit .env.

# Meta Model API key (Bearer token). Get one at https://dev.meta.ai
META_API_KEY=

# OpenAI-compatible base URL for the Meta Model API (Responses endpoint lives at $META_BASE_URL/responses)
META_BASE_URL=https://api.meta.ai/v1

# Model id — see https://dev.meta.ai/docs/models
META_MODEL=muse-spark-1.3
